<Project>

  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <!-- Turns on the trimming / Native AOT analyzers so dynamic-reflection use fails the build early. -->
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

</Project>
