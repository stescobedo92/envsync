<Project>

  <ItemGroup>
    <!-- Runtime -->
    <PackageVersion Include="System.CommandLine" Version="2.0.12" />
    <PackageVersion Include="Azure.Security.KeyVault.Secrets" Version="4.11.1" />
    <PackageVersion Include="Azure.Identity" Version="1.21.0" />
    <PackageVersion Include="AWSSDK.SecretsManager" Version="4.0.100.14" />
    <!-- The SDK loads these lazily, only when a profile needs them: without them SSO and assume-role profiles fail at runtime. -->
    <PackageVersion Include="AWSSDK.SSO" Version="4.0.100.16" />
    <PackageVersion Include="AWSSDK.SSOOIDC" Version="4.0.100.15" />
    <PackageVersion Include="AWSSDK.SecurityToken" Version="4.0.101" />
    <!-- Tests -->
    <PackageVersion Include="xunit.v3.mtp-v2" Version="4.0.1" />
  </ItemGroup>

</Project>
